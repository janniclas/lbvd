{
  "name": "@jan-niclas/lbvd",
  "version": "0.1.1",
  "type": "module",
  "description": "Automated vulnerability scanning for repositories using coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janniclas/lbvd.git"
  },
  "bin": {
    "lbvd": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "cli": "tsx ./src/cli.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:unit": "tsx --test 'tests/unit/*.test.ts'",
    "test:workflow": "tsx --test 'tests/workflow/*.test.ts'",
    "test:reporter": "tsx --test 'tests/reporter-contract/*.test.ts'",
    "lint:boundaries": "tsx ./scripts/lint-boundaries.ts",
    "lint": "npm run lint:boundaries",
    "record-http:github": "tsx ./scripts/record-http.ts",
    "synth-http": "tsx ./scripts/synth-http.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.144",
    "ajv": "8.20.0",
    "commander": "14.0.3",
    "ignore": "7.0.5",
    "undici": "8.3.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "25.9.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
